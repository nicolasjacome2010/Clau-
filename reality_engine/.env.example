# Copy to .env for local development. Never commit the real .env file.

VAROS_RE_ENVIRONMENT=development

# Without this, the safety-classification tier has zero providers and
# SafetyGateAgent always fails safe to HALT_AND_REFER (intentional — see
# src/reality_engine/config.py).
VAROS_RE_OPENAI_API_KEY=
VAROS_RE_OPENAI_SAFETY_MODEL=gpt-5-mini
VAROS_RE_OPENAI_EXTRACTION_MODEL=gpt-5-mini
VAROS_RE_OPENAI_REASONING_MODEL=gpt-5.1
# Agent 11 (Memoria). Without this, /v1/simulate always returns memory: null.
VAROS_RE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
