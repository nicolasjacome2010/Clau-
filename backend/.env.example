# Copy to .env for local development. Never commit the real .env file.

VAROS_ENVIRONMENT=development
VAROS_DATABASE_URL=postgresql+asyncpg://varos:varos@localhost:5432/varos

VAROS_SUPABASE_URL=https://your-project.supabase.co
VAROS_SUPABASE_JWT_AUDIENCE=authenticated
# Only set this to point at a non-standard JWKS endpoint (self-hosted Supabase, local mock).
VAROS_SUPABASE_JWKS_URL_OVERRIDE=

VAROS_CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Fernet key protecting sensitive fields at the application layer (e.g. a
# decision's raw text, docs/DATABASE.md §5). Generate a real one per
# environment with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production should source this from AWS KMS, not a static env var (see docs/ARCHITECTURE.md §11).
VAROS_FIELD_ENCRYPTION_KEY=

# Base URL of the Reality Engine service (separate deployment/venv, see
# reality_engine/README.md). RunSimulationUseCase calls it synchronously.
VAROS_REALITY_ENGINE_BASE_URL=http://localhost:8100

# Stripe (docs/ARCHITECTURE.md §2.4/§9). Without these, checkout/portal
# session creation fails with a 503 and every webhook is rejected with a
# 400 (an empty webhook secret makes signature verification always fail —
# fail-closed, not fail-open, same posture as the Reality Engine's safety
# gate). Price IDs are NOT configured here: the client (Flutter app/web)
# owns the pricing catalog and passes the chosen `price_id` per request.
VAROS_STRIPE_SECRET_KEY=
VAROS_STRIPE_WEBHOOK_SECRET=
